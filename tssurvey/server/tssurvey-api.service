[Unit]
Description=TSSURVEY API Service
After=network.target

[Service]
Type=simple
User=root
# Adjust this path based on actual deployment
WorkingDirectory=/opt/tssurvey
ExecStart=/usr/bin/python3 /opt/tssurvey/tssurvey_api.py
Restart=always
RestartSec=3

Environment=HOST=127.0.0.1
Environment=PORT=8091
# Change DB path to somewhere outside webroot for production
Environment=TSSURVEY_DB_PATH=/var/lib/tssurvey/tssurvey_data.db
# 관리자 비밀번호의 SHA-256 해시(원문 아님). 관리자 API 인증에 사용.
#   해시 생성: python3 -c "import hashlib;print(hashlib.sha256(b'<새비밀번호>').hexdigest())"
#   ⚠️ 아래 값은 기존 비밀번호 해시다. 이미 노출된 값이므로 배포 시 새 비밀번호로 교체 권장.
Environment=ADMIN_PW_SHA256=52b8888632a11bbb56838f1adf17466ecdb7cd0ea41fbdd89c585e855dbca358

[Install]
WantedBy=multi-user.target
