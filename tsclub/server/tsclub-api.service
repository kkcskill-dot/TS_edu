[Unit]
Description=TSCLUB API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/Users/kichan/tech_edu/PerformanceDiagnostics/tsclub/server
ExecStart=/usr/bin/python3 /Users/kichan/tech_edu/PerformanceDiagnostics/tsclub/server/tsclub_api.py
Restart=always
RestartSec=3

Environment=HOST=127.0.0.1
Environment=PORT=8092

[Install]
WantedBy=multi-user.target
